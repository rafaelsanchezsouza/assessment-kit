{
  "name": "assessment-kit-monorepo",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "build": "turbo build",
    "test": "turbo test",
    "lint": "turbo lint",
    "protocols:validate": "pnpm --filter @assessment-kit/protocol-tools validate ../../protocols ../../catalog",
    "lint:layering": "! grep -riEn 'nativa|nbs|paraiba|paraíba' packages/ --include='*.ts' --include='*.tsx' --include='*.json' --include='*.sql' --include='*.md'",
    "verify": "pnpm build && pnpm test && pnpm protocols:validate && pnpm lint:layering"
  },
  "devDependencies": { "turbo": "^2.10.8", "typescript": "^7.0.2", "@types/node": "^26.1.2" }
}
